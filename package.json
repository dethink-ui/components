{
  "name": "dethink-components-workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "test:chat-bubble": "playwright test --config=e2e/chat-bubble.config.ts",
    "registry:smoke:chat-bubble": "node scripts/smoke-chat-registry.mjs --bubble",
    "registry:smoke:chat-bubble:react18": "node scripts/smoke-chat-registry.mjs --bubble --react18",
    "test:voice-input": "playwright test --config=e2e/voice-input.config.ts",
    "test:shader-hero": "playwright test --config=e2e/shader-hero-text.config.ts",
    "registry:smoke:shader-hero": "node scripts/smoke-shader-hero-registry.mjs",
    "build": "pnpm --filter @dethink/components build && pnpm --filter @dethink/playground-vite build",
    "check": "pnpm docs:dependencies:check && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "format": "prettier --write \".github/**/*.{yml,yaml}\" \"apps/**/*.{css,js,jsx,json,md,mdx,mjs,cjs,ts,tsx}\" \"packages/**/*.{css,js,jsx,json,md,mdx,mjs,cjs,ts,tsx}\" \"registry/**/*.json\" \"scripts/**/*.{js,mjs,cjs,ts}\" \"*.{js,json,mjs,cjs,ts}\" \"tsconfig*.json\" \"pnpm-workspace.yaml\"",
    "format:check": "prettier --check \".github/**/*.{yml,yaml}\" \"apps/**/*.{css,js,jsx,json,md,mdx,mjs,cjs,ts,tsx}\" \"packages/**/*.{css,js,jsx,json,md,mdx,mjs,cjs,ts,tsx}\" \"registry/**/*.json\" \"scripts/**/*.{js,mjs,cjs,ts}\" \"*.{js,json,mjs,cjs,ts}\" \"tsconfig*.json\" \"pnpm-workspace.yaml\"",
    "lint": "eslint \"**/*.{js,mjs,cjs,ts,tsx}\" --max-warnings 0",
    "lint:fix": "eslint \"**/*.{js,mjs,cjs,ts,tsx}\" --fix --max-warnings 0",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:a11y": "pnpm -r --if-present test:a11y",
    "storybook": "pnpm --filter @dethink/storybook storybook",
    "storybook:build": "pnpm --filter @dethink/storybook storybook:build",
    "docs:dependencies": "node scripts/generate-component-dependencies.mjs",
    "docs:dependencies:check": "node scripts/generate-component-dependencies.mjs --check",
    "registry:validate": "node scripts/validate-registry.mjs",
    "registry:build": "node scripts/build-registry.mjs",
    "registry:test": "node --test scripts/build-registry.test.mjs",
    "registry:smoke": "node scripts/smoke-button-registry.mjs",
    "test:e2e": "playwright test",
    "test:accessibility:report": "playwright test --config=e2e/accessibility-report.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "capture:showcase": "node scripts/capture-showcase-final.mjs",
    "capture:recipes": "node scripts/capture-recipe-thumbnails.mjs",
    "changeset": "changeset",
    "test:shader-backgrounds": "playwright test --config=e2e/shader-backgrounds.config.ts",
    "registry:smoke:shader-backgrounds": "node scripts/smoke-shader-hero-registry.mjs --backgrounds",
    "test:carousel": "playwright test --config=e2e/carousel-modes.config.ts",
    "registry:smoke:carousel": "node scripts/smoke-carousel-registry.mjs",
    "test:sidebar-shell": "playwright test --config=e2e/sidebar-shell.config.ts",
    "registry:smoke:sidebar-shell": "node scripts/smoke-sidebar-shell-registry.mjs",
    "registry:smoke:sidebar-activity": "node scripts/smoke-sidebar-shell-registry.mjs --activity",
    "registry:smoke:bottom-bar": "node scripts/smoke-sidebar-shell-registry.mjs --bottom-bar"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.3.5",
    "@playwright/cli": "^0.1.21",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript-eslint": "^8.70.0"
  }
}
