{
  "name": "@dethink/components",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Open-code React components for production dashboards, internal tools, and AI-native applications.",
  "homepage": "https://components.dethink.co.uk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dethink-ui/components.git",
    "directory": "packages/components"
  },
  "bugs": {
    "url": "https://github.com/dethink-ui/components/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/styles.css",
    "./src/styles.css"
  ],
  "files": [
    "dist",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./chat-markdown": {
      "types": "./dist/chat-markdown.d.ts",
      "import": "./dist/chat-markdown.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:bundle": "node scripts/check-bundle.mjs",
    "test:a11y": "vitest run src/foundation/*.a11y.test.tsx src/components/*/*.a11y.test.tsx"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@tanstack/react-table": "9.2.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "motion": "^12.43.0",
    "react-aria": "^3.52.1",
    "react-aria-components": "^1.21.1",
    "react-resizable-panels": "^4.13.2",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": ">=18.3 <20",
    "react-dom": ">=18.3 <20",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^4.1.11"
  },
  "peerDependenciesMeta": {
    "react-markdown": {
      "optional": true
    },
    "remark-gfm": {
      "optional": true
    }
  }
}
